# ── Secrets: never commit ────────────────────────────────────────────────────
# Release signing. `keystore.properties` contains the real passwords and the
# .jks is the key itself; either one in the repository lets anyone sign an
# update that Android will install over the real app.
keystore.properties
keystore.properties.*
!keystore.properties.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.p8
*.mobileprovision
*.ovpn
google-services.json
GoogleService-Info.plist

# Environment files. Only .example templates are meant to be committed.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Machine-specific paths (Android SDK location, local overrides).
local.properties
local.properties.*

